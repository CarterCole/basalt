{
  "name": "basalt-vault",
  "version": "1.0.0",
  "description": "Basalt Protocol v1 — a portable knowledge vault in any S3-compatible object store, with inherited permissions and derived link indexes",
  "keywords": [
    "basalt",
    "knowledge-base",
    "markdown",
    "wikilink",
    "obsidian",
    "s3",
    "minio",
    "r2",
    "git",
    "gist",
    "acl",
    "publish",
    "vault"
  ],
  "homepage": "https://github.com/CarterCole/ts-basalt#readme",
  "bugs": {
    "url": "https://github.com/CarterCole/ts-basalt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarterCole/ts-basalt.git"
  },
  "license": "MIT",
  "author": "Carter Cole",
  "type": "module",
  "main": "src/vault.mjs",
  "exports": {
    ".": "./src/vault.mjs",
    "./transport/fs": "./src/transport/fs.mjs",
    "./transport/s3": "./src/transport/s3.mjs",
    "./transport/memory": "./src/transport/memory.mjs",
    "./transport/git": "./src/transport/git.mjs",
    "./transport/gist": "./src/transport/gist.mjs",
    "./gist": "./src/gist.mjs",
    "./store": "./src/store.mjs",
    "./gatekeeper": "./src/gatekeeper.mjs",
    "./site": "./src/web/site.mjs",
    "./export": "./src/web/export.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "basalt": "bin/basalt.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node bin/basalt.mjs check",
    "serve": "node bin/basalt.mjs serve"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "marked": "^18.1.1",
    "yaml": "^2.8.1"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/client-sts": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0"
  },
  "engines": {
    "node": ">=20"
  }
}
